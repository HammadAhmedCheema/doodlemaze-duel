{
  "name": "doodlemaze-duel",
  "version": "0.1.0",
  "private": true,
  "description": "Draw a maze, let an open-weight VLM theme it, then race your friend through it in 3D.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "models:vision": "tsx scripts/list-vision-models.ts",
    "sim": "tsx scripts/sim.ts",
    "vlm:test": "tsx scripts/vlm-smoke.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "three": "^0.170.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
